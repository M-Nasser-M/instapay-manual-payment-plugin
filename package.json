{
  "name": "@m-nasser-m/medusa-payment-instapay-manual",
  "version": "0.0.8",
  "description": "A manual payment provider for Medusa that processes Instapay Cash payments requiring manual verification before order completion",
  "author": "Mohamed Nasser",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/M-Nasser-M/instapay-manual-payment-plugin"
  },
  "files": [
    ".medusa/server"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    },
    "./*": "./.medusa/server/src/*.js"
  },
  "keywords": [
    "medusa",
    "medusa-v2",
    "medusa-plugin",
    "medusa-plugin-integration",
    "medusa-plugin-payment",
    "medusa-payment",
    "medusa-payment-instapay-manual",
    "payment",
    "plugin"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "yarn predev && medusa plugin:develop",
    "predev": "medusa plugin:publish",
    "prepublishOnly": "medusa plugin:build",
    "bunpublish": "bun publish"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "^2.15.2",
    "@medusajs/cli": "^2.15.2",
    "@medusajs/framework": "^2.15.2",
    "@medusajs/icons": "^2.15.2",
    "@medusajs/medusa": "^2.15.2",
    "@medusajs/test-utils": "^2.15.2",
    "@medusajs/ui": "4.2.0",
    "@swc/core": "1.5.7",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "^2.15.2",
    "@medusajs/cli": "^2.15.2",
    "@medusajs/framework": "^2.15.2",
    "@medusajs/icons": "^2.15.2",
    "@medusajs/medusa": "^2.15.2",
    "@medusajs/test-utils": "^2.15.2",
    "@medusajs/ui": "4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "node": ">=22"
  },
  "trustedDependencies": [
    "@medusajs/telemetry",
    "@swc/core"
  ]
}